{
  "schemaVersion": 1,
  "name": "search by DOI",
  "command": ["search", "--doi", "10.1038/nature12373"],
  "rpc": {
    "method": "search.byIdentifier",
    "params": {
      "doi": "10.1038/nature12373"
    },
    "result": {
      "key": "ID1",
      "title": "Identifier matched item",
      "DOI": "10.1038/nature12373"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\"key\":\"ID1\",\"title\":\"Identifier matched item\",\"DOI\":\"10.1038/nature12373\"}\n"
  }
}
