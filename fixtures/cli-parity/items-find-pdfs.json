{
  "schemaVersion": 1,
  "name": "items find-pdfs missing scan",
  "command": [
    "items",
    "find-pdfs",
    "--collection",
    "Reading List",
    "--limit",
    "1"
  ],
  "rpc": {
    "calls": [
      {
        "method": "collections.list",
        "params": null,
        "result": [
          {
            "key": "COL1",
            "name": "Reading List",
            "parentKey": null
          }
        ]
      },
      {
        "method": "collections.getItems",
        "params": {
          "key": "COL1"
        },
        "result": {
          "items": [
            {
              "key": "ITEM1",
              "title": "Already Has PDF"
            },
            {
              "key": "ITEM2",
              "title": "Needs PDF"
            }
          ],
          "total": 2
        }
      },
      {
        "method": "attachments.list",
        "params": {
          "parentKey": "ITEM1"
        },
        "result": [
          {
            "key": "ATT1",
            "contentType": "application/pdf",
            "path": "/tmp/already.pdf"
          }
        ]
      },
      {
        "method": "attachments.list",
        "params": {
          "parentKey": "ITEM2"
        },
        "result": []
      },
      {
        "method": "attachments.findPDF",
        "params": {
          "parentKey": "ITEM2"
        },
        "result": {
          "attachment": {
            "key": "ATT2",
            "title": "Found PDF"
          }
        }
      }
    ]
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\"scanned\":2,\"attempted\":1,\"results\":[{\"item_key\":\"ITEM2\",\"title\":\"Needs PDF\",\"found\":true,\"attachment_key\":\"ATT2\"}]}\n"
  }
}
