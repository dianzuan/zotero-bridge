    "stdout": "{\n  \"items\": [\n    {\n      \"key\": \"NOTE2\",\n      \"note\": \"Found note\",\n      \"version\": 1\n    }\n  ],\n  \"total\": 1,\n  \"limit\": 10\n}\n"
