        "result": {
          "key": "ITEM1",
          "text": "全文内容摘要"
        }
      }
    ]
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\"key\":\"ITEM1\",\"text\":\"全文内容摘要\",\"source\":\"zotero\"}\n"
  }
