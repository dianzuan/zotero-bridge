#!/usr/bin/env bash
# Zotron CLI wrapper — delegates to the installed zotron binary, or prints install help.
set -euo pipefail

SELF="$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"

# Find the real binary on PATH (skip this wrapper)
IFS=: read -ra _path_dirs <<< "$PATH"
for dir in "${_path_dirs[@]}"; do
  for name in zotron zotron.exe; do
    candidate="${dir}/${name}"
    [ -x "${candidate}" ] && [ "$(cd -- "$(dirname -- "${candidate}")" && pwd)/$(basename -- "${candidate}")" != "${SELF}" ] && exec "${candidate}" "$@"
  done
done

echo "zotron CLI not found. Install it:" >&2
echo "  Download: https://github.com/dianzuan/zotron/releases/latest" >&2
echo "  Or run: /zotron:setup" >&2
exit 127
