{
  "schemaVersion": 1,
  "name": "rpc paginate page size",
  "command": [
    "rpc",
    "items.list",
    "{\"tag\":\"ai\"}",
    "--paginate",
    "--page-size",
    "2"
  ],
  "rpc": {
    "calls": [
      {
        "method": "items.list",
        "params": {
          "tag": "ai",
          "offset": 0,
          "limit": 2
        },
        "result": {
          "items": [
            {
              "key": "ITEM1"
            },
            {
              "key": "ITEM2"
            }
          ],
          "total": 3
        }
      },
      {
        "method": "items.list",
        "params": {
          "tag": "ai",
          "offset": 2,
          "limit": 2
        },
        "result": {
          "items": [
            {
              "key": "ITEM3"
            }
          ],
          "total": 3
        }
      }
    ]
  },
  "expect": {
    "exitCode": 0,
    "stdout": "[{\"key\":\"ITEM1\"},{\"key\":\"ITEM2\"},{\"key\":\"ITEM3\"}]\n"
  }
}
