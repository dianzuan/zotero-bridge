{
  "schemaVersion": 1,
  "name": "attachments find pdf",
  "command": [
    "attachments",
    "find-pdf",
    "--parent",
    "ITEM1"
  ],
  "rpc": {
    "method": "attachments.findPDF",
    "params": {
      "parentKey": "ITEM1"
    },
    "result": {
      "found": true,
      "attachment": {
        "key": "ATT4",
        "title": "Available PDF"
      }
    }
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\n  \"found\": true,\n  \"attachment\": {\n    \"key\": \"ATT4\",\n    \"title\": \"Available PDF\"\n  }\n}\n"
  }
}
