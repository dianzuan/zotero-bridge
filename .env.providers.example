# Copy to .env.providers and fill local credentials.
# Never put real credentials in this example file.
#
# Load locally with:
#   set -a; source .env.providers; set +a

ZOTRON_GLM_API_KEY=
ZOTRON_GLM_ENDPOINT=

ZOTRON_PADDLEOCR_VL_API_KEY=
ZOTRON_PADDLEOCR_VL_ENDPOINT=<your-aistudio-layout-parsing-endpoint>
ZOTRON_PADDLEOCR_VL_SYNC_ENDPOINT=<your-aistudio-layout-parsing-endpoint>
ZOTRON_PADDLEOCR_VL_JOBS_ENDPOINT=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
ZOTRON_PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.5

ZOTRON_MINERU_API_KEY=
ZOTRON_MINERU_ENDPOINT=

ZOTRON_DOUBAO_API_KEY=
ZOTRON_DOUBAO_ENDPOINT=

ZOTRON_QWEN_API_KEY=
ZOTRON_QWEN_ENDPOINT=

ZOTRON_VOLCENGINE_API_KEY=
ZOTRON_VOLCENGINE_EMBEDDING_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/embeddings
ZOTRON_VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-text-240715

ZOTRON_DASHSCOPE_API_KEY=
ZOTRON_DASHSCOPE_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
ZOTRON_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

ZOTRON_CUSTOM_API_KEY=
ZOTRON_CUSTOM_ENDPOINT=
ZOTRON_CUSTOM_EMBEDDING_MODEL=
