{
  "schemaVersion": 1,
  "name": "items list --trash flag",
  "command": [
    "items",
    "list",
    "--trash",
    "--limit",
    "10"
  ],
  "rpc": {
    "method": "items.getTrash",
    "params": {
      "limit": 10,
      "offset": 0
    },
    "result": {
      "items": [
        {
          "key": "TRASH1",
          "title": "Deleted draft"
        }
      ],
      "total": 1,
      "limit": 10,
      "offset": 0
    }
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\n  \"items\": [\n    {\n      \"key\": \"TRASH1\",\n      \"title\": \"Deleted draft\"\n    }\n  ],\n  \"total\": 1,\n  \"limit\": 10,\n  \"offset\": 0,\n  \"hasMore\": false\n}\n"
  }
}
