{
  "schemaVersion": 1,
  "name": "system library stats",
  "command": [
    "system",
    "library-stats",
    "--library",
    "42"
  ],
  "rpc": {
    "method": "system.libraryStats",
    "params": {
      "id": 42
    },
    "result": {
      "libraryId": 42,
      "items": 120,
      "collections": 8,
      "attachments": 44
    }
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\"libraryId\":42,\"items\":120,\"collections\":8,\"attachments\":44}\n"
  }
}
