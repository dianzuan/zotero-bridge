#!/usr/bin/env bash
# Zotron CLI — Rust RPC client for the Zotron XPI
# Usage: zotron ping | zotron search quick "..." | zotron ocr status | zotron rag hits
set -euo pipefail
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}"
if [ -z "${PLUGIN_ROOT}" ]; then
  PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fi

resolve_path() {
  local path="$1"
  if command -v readlink >/dev/null 2>&1; then
    readlink -f "${path}" 2>/dev/null && return 0
  fi
  local dir
  dir="$(cd -- "$(dirname -- "${path}")" && pwd)"
  printf '%s/%s\n' "${dir}" "$(basename -- "${path}")"
}

SELF="$(resolve_path "$0")"

if [ -n "${ZOTRON_RUST_BIN:-}" ]; then
  exec "${ZOTRON_RUST_BIN}" "$@"
fi

REPO_ROOT="$(cd -- "${PLUGIN_ROOT}/.." && pwd)"
for candidate in \
  "${REPO_ROOT}/target/release/zotron" \
  "${REPO_ROOT}/target/debug/zotron"
do
  if [ -x "${candidate}" ]; then
    exec "${candidate}" "$@"
  fi
done

PATH_ZOTRON="$(command -v zotron 2>/dev/null || true)"
if [ -n "${PATH_ZOTRON}" ] && [ "$(resolve_path "${PATH_ZOTRON}")" != "${SELF}" ]; then
  exec "${PATH_ZOTRON}" "$@"
fi

case "${1:-}" in
  ocr|rag)
    echo "MISSING_RUST_ZOTRON: install the Rust CLI with 'cargo install --path crates/zotron-cli --root ~/.local --force'." >&2
    exit 127
    ;;
esac

echo "MISSING_RUST_ZOTRON: install the Rust CLI with 'cargo install --path crates/zotron-cli --root ~/.local --force'." >&2
exit 127
