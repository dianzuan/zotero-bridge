{
  "schemaVersion": 1,
  "name": "search with --author and --tag flags",
  "command": ["search", "--author", "张三", "--tag", "核心期刊", "--limit", "20"],
  "rpc": {
    "method": "search.advanced",
    "params": {
      "conditions": [
        { "field": "creator", "operator": "contains", "value": "张三" },
        { "field": "tag", "operator": "is", "value": "核心期刊" }
      ],
      "operator": "and",
      "limit": 20,
      "offset": 0
    },
    "result": {
      "items": [],
      "total": 0,
      "limit": 20,
      "offset": 0,
      "hasMore": false
    }
  },
  "expect": {
    "exitCode": 0,
    "stdout": "{\n  \"items\": [],\n  \"total\": 0,\n  \"limit\": 20,\n  \"offset\": 0,\n  \"hasMore\": false\n}\n"
  }
}
